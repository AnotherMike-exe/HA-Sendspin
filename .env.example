# Copy to .env and fill in. .env is gitignored — never commit the real token.
# See docs/DEPLOYMENT-TESTING.md for how to create the token and what it grants.

HA_BASE_URL=http://homeassistant.local:8123

# Long-lived access token. HA UI -> your user -> Security -> Long-lived access
# tokens. This is admin-equivalent over the REST API; revoke it from the same
# page if it is ever exposed.
HA_TOKEN=

# Override if HACS names the update entity differently on your instance.
# HA_UPDATE_ENTITY=update.sendspin_update
